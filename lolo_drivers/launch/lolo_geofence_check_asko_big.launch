<launch>
  <arg name="robot_name" default="lolo" />

  <node pkg="geofence_checker" exec="geofence_checker_service" name="geofence_server_node" output="screen" namespace="$(var robot_name)">
    <param name="geofence_file" value="asko_big.yaml" />
    <param name="verbose" value="True" />
  </node>

  <node pkg="lolo_drivers" exec="geofence_checker_client" name="geofence_client_node" output="screen" namespace="$(var robot_name)">
    <param name="verbose" value="True" />
  </node>

</launch>
